{
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["*.js", "*.d.ts", "features/**/*.js", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "eslint.config.js"]
}
