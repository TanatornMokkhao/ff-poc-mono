# Every setting the BE reads. Values here are local examples only.
# Each stage's values are in Parameter Store /ff-poc/<stage>/be/<KEY>, never in git.
# Lines marked "# secret" are SecureString there; the rest are String.
# "optional" means the server starts without it (DATABASE_URL: /notes answers 503 until a DB exists).
# The deploy checks every key here has a value before it starts the server.
APP_ENV=local
LOG_LEVEL=debug
APP_URL=http://localhost:3000
DB_HOST=localhost
DB_NAME=ff_local
DB_USERNAME=ff_app
REDIS_QUEUE_HOST=localhost
DB_PASSWORD= # secret
STRIPE_SECRET_KEY= # secret
SENDGRID_API_KEY= # secret
DATABASE_URL= # secret optional
