# Every setting the FE reads from config.json. Values here are local examples.
# Each stage's values are variables of the build-staging / build-prod environment in ff-poc-mono.
# They are baked into config.json once per release candidate, for the web and the apps alike.
# The browser and the app package expose all of them, so none is secret: a private key belongs to the BE.
# The build stops and names any key that has no value for its stage.
API_BASE_URL=http://localhost:3000
WS_BASE_URL=ws://localhost:3000
API_VERSION=v1
STRIPE_PUBLISH_KEY=pk_test_local
RECAPTCHA_SITE_KEY=local-site-key
GOOGLE_PLACES_API_KEY=local-places-key
DD_APP_ID=local-dd-app
DD_CLIENT_TOKEN=local-dd-token
SUPPORT_EMAIL=support+local@example.com
FEATURE_WELCOME_TOUR=true
FEATURE_WELCOME_BANNER=true
